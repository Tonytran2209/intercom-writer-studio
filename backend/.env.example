# AI providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Required for email/password login through Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://your-app.example.com
# Comma-separated admin email addresses. Alternatively assign
# app_metadata.role = "admin" in Supabase Auth for a user.
ADMIN_EMAILS=

# Temporary shared-internal V2 mode. Set to "required" to restore Supabase Auth.
WRITER_AUTH_MODE=disabled

# Step 2 SEO research uses OpenAI Web Search through OPENAI_API_KEY above.

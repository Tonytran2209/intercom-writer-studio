# Use one server-only key. SUPABASE_SECRET_KEY is the current Supabase name;
# SUPABASE_SERVICE_ROLE_KEY remains supported for existing Railway projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=


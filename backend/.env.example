# AI providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Server-side Supabase persistence. The browser never talks to Supabase or
# authenticates users; use a server-only secret key.
SUPABASE_URL=
# Use one server-only key. SUPABASE_SECRET_KEY is the current Supabase name;
# SUPABASE_SERVICE_ROLE_KEY remains supported for existing Railway projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set DATABASE_PROVIDER=postgres only AFTER schema/data/file verification.
DATABASE_PROVIDER=supabase
# Railway PostgreSQL connection (not sufficient alone to switch production).
# Production: reference ${{Postgres.DATABASE_URL}}; local CLI: private env file.
DATABASE_URL=
# Migration only: direct PostgreSQL connection to the existing Supabase DB.
SOURCE_DATABASE_URL=

# Step 2 SEO research uses OpenAI Web Search through OPENAI_API_KEY above.
